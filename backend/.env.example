# =============================================================================
# MediOps Intelligence backend configuration.
# Copy to backend/.env for local runs. NEVER commit real values.
# In deployment, set these in the host's environment settings, not in files.
# =============================================================================

# ---- Application ----
APP_NAME=MediOps Intelligence
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# ---- Database (PostgreSQL 16, psycopg 3 driver) ----
DATABASE_URL=postgresql+psycopg://healthcare:healthcare@localhost:5432/healthcare_bi

# ---- CORS: comma-separated browser origins allowed to call the API ----
CORS_ORIGINS=http://localhost:5173

# ---- Auth / JWT (Phase 1) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ISSUER=careops-intelligence
JWT_AUDIENCE=careops-intelligence-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Set false only for plain-http local dev
COOKIE_SECURE=true

# ---- First admin, seeded once (Phase 1) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Uploads (Phase 2) ----
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=100000

# ---- LLM / CrewAI (Phase 4); provider-agnostic, model string per LiteLLM ----
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
MAX_LLM_CALLS_PER_ANALYSIS=40

# ---- Worker (Phase 4) ----
ANALYSIS_TIMEOUT_SECONDS=900
WORKER_POLL_SECONDS=2
